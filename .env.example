# Social Champ MCP server configuration.
#
# Copy this file to .env and fill in your values.
# Never commit .env. It is ignored by .gitignore and holds your secret key.

# Required. Bearer token for Social Champ: an API key or OAuth2 access token.
# Create an API key in your Social Champ account settings.
SOCIALCHAMP_API_KEY=

# Optional. Override the hosted MCP endpoint (for example a local test server).
# Default: https://mcp.socialchamp.com/mcp
# SOCIALCHAMP_API_BASE_URL=http://localhost:3000/mcp

# Optional. Request timeout in seconds. Default: 30
# SOCIALCHAMP_TIMEOUT=30

# Optional. Transport for the MCP server: stdio, sse, or streamable-http.
# Default: stdio
# SOCIALCHAMP_TRANSPORT=stdio

# Optional. MCP protocol version sent on initialize. Default: 2025-06-18
# SOCIALCHAMP_MCP_PROTOCOL_VERSION=2025-06-18
