# Social Champ MCP server configuration.
#
# Copy this file to .env and fill in your values.
# Never commit .env. It is ignored by .gitignore and holds your secret key.

# Required. Bearer token for the Social Champ API.
# Create one in your Social Champ account settings.
SOCIALCHAMP_API_KEY=

# Optional. Override the API base URL.
# Default: https://api.socialchamp.com/api/v1
# SOCIALCHAMP_API_BASE_URL=https://api.socialchamp.com/api/v1

# Optional. Request timeout in seconds. Default: 30
# SOCIALCHAMP_TIMEOUT=30

# Optional. Transport for the MCP server: stdio, sse, or streamable-http.
# Default: stdio
# SOCIALCHAMP_TRANSPORT=stdio
